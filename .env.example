# ─────────────────────────────────────────────────────────────────────────────
# Neuro Tech Voice — environment variables (names only; never commit values).
# Server-only unless prefixed NEXT_PUBLIC_. See docs/voice-providers.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                 # e.g. https://app.example.com
NEXT_PUBLIC_APP_NAME=
LOG_LEVEL=                           # debug | info | warn | error (default info)

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only: webhooks, routing, provider sync

# ── Voice routing (platform) ─────────────────────────────────────────────────
VOICE_PUBLIC_BASE_URL=               # public HTTPS origin Twilio/providers call (defaults to NEXT_PUBLIC_APP_URL)
VOICE_TOKEN_SECRET=                  # ≥32 random chars: signs per-call tokens (transfer tool, TwiML callbacks)
VOICE_FALLBACK_ENABLED=              # true (default) | false — platform-wide Cartesia fallback switch
VOICE_FORCE_PROVIDER=                # auto (default) | elevenlabs | cartesia — incident kill switch
VOICE_EARLY_FAILURE_WINDOW_SECONDS=  # default 6: early stream failure that still fails over
VOICE_LIBRARY_MIN_NOTICE_DAYS=       # default 30: only library voices with ≥ N days removal notice
VOICE_CIRCUIT_FAILURE_THRESHOLD=     # default 3 consecutive failures
VOICE_CIRCUIT_WINDOW_MS=             # default 60000
VOICE_CIRCUIT_WINDOW_MIN_EVENTS=     # default 5
VOICE_CIRCUIT_OPEN_MS=               # default 30000 (doubles per re-open)
VOICE_CIRCUIT_MAX_OPEN_MS=           # default 300000
VOICE_CIRCUIT_PROBE_LEASE_MS=        # default 15000
TELEMETRY_SUCCESS_SAMPLE_RATE=       # default 0.1 (successful provider calls persisted)
PROVIDER_EVENTS_RETENTION_DAYS=      # default 30
WEBHOOK_EVENTS_RETENTION_DAYS=       # default 90 (processed receipts = dedupe window)
WEBHOOK_PAYLOAD_RETENTION_DAYS=      # default 30 (payloads of dead-lettered events)
ALLOW_UNSIGNED_WEBHOOKS=             # local development only; ignored in production

# ── ElevenLabs (primary) ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=                  # least-privilege key: permissions listed in docs/elevenlabs/G.md
ELEVENLABS_WEBHOOK_SECRET=           # HMAC secret of the workspace post-call webhook (required)
ELEVENLABS_WEBHOOK_SECRET_PREVIOUS=  # optional: previous secret accepted during a rotation
ELEVENLABS_POST_CALL_WEBHOOK_ID=     # optional: otherwise the webhook pointing at /api/elevenlabs/webhook is discovered
ELEVENLABS_TOOL_SECRET=              # ≥32 chars (required in production): X-NTV-Tool-Key of platform tools and the initiation webhook
ELEVENLABS_TOOL_SECRET_PREVIOUS=     # optional: previous tool secret accepted during a rotation
ELEVENLABS_API_BASE_URL=             # optional (data residency), default https://api.elevenlabs.io
ELEVENLABS_LLM=                      # optional, default gpt-5.4-mini (validated against /v1/convai/llm/list)
ELEVENLABS_BACKUP_LLM=               # default 'default' (provider backup LLM); 'disabled' turns it off
ELEVENLABS_LLM_CASCADE_TIMEOUT_SECONDS= # default 4 (2-15)
ELEVENLABS_REASONING_EFFORT=         # default: lowest level the LLM supports
ELEVENLABS_TTS_MODEL_EN=             # optional, default eleven_flash_v2 (allowed: flash_v2, flash_v2_5, v4_turbo, v3_conversational)
ELEVENLABS_TTS_MODEL_MULTILINGUAL=   # optional, default eleven_flash_v2_5
ELEVENLABS_TEXT_NORMALISATION=       # default elevenlabs | system_prompt
ELEVENLABS_AGENT_AUTH=               # default on (no anonymous sessions); 'false' only if a live test needs it
ELEVENLABS_TRANSFER_TOOL_ID=         # optional: pin the platform transfer tool instead of auto-creating it
ELEVENLABS_TRUST_CONTEXT=            # default unknown | low
# Guardrails and privacy
ELEVENLABS_ENABLE_GUARDRAILS=        # default on; 'false' turns every guardrail off
ELEVENLABS_GUARDRAIL_FOCUS=          # default true
ELEVENLABS_GUARDRAIL_PROMPT_INJECTION= # default true
ELEVENLABS_CONTENT_GUARDRAILS=       # optional comma list of content categories (default off)
ELEVENLABS_CONTENT_GUARDRAIL_THRESHOLD= # default 0.3
ELEVENLABS_PII_REDACTION=            # default true (payment card numbers; enterprise-only, falls back automatically)
ELEVENLABS_EMBEDDING_RETENTION_DAYS= # default 30: workspace conversation-embedding retention to align to
# Capacity (never tenant-editable)
ELEVENLABS_CONCURRENCY_TRIAL=        # default 2 concurrent calls per agent
ELEVENLABS_CONCURRENCY_STARTER=      # default 2
ELEVENLABS_CONCURRENCY_PRO=          # default 4
ELEVENLABS_CONCURRENCY_BUSINESS=     # default 6
ELEVENLABS_CONCURRENCY_CUSTOM=       # default 10
ELEVENLABS_DAILY_CALL_LIMIT=         # default 500 conversations per agent per day
ELEVENLABS_BURSTING=                 # default true (overflow above the workspace limit billed at 2x)
ELEVENLABS_CONCURRENCY_LIMIT=        # optional: workspace limit, enables the 80% concurrency warning
VOICE_TRIAL_MINUTES_ENFORCED=        # default true: plans without overage stop at their included minutes
# Config rollout and reconciliation (maintenance)
ELEVENLABS_ROLLOUT_BATCH=            # default 10 agents re-synced per run (0 = off)
ELEVENLABS_ROLLOUT_SCAN=             # default 100 agents hashed per run
ELEVENLABS_ROLLOUT_CANARY_ORGS=      # optional comma list of org ids rolled out first
ELEVENLABS_RECONCILE_BATCH=          # default 20 calls checked per run for lost webhooks
ELEVENLABS_RECONCILE_SWEEP_AGENTS=   # default 5
ELEVENLABS_RECONCILE_MAX_FETCHES=    # default 40
CALL_RETENTION_BATCH=                # default 500 calls cleared per run when retention applies
VOICE_MAINTENANCE_BUDGET_MS=         # default 240000: wall-clock budget of one maintenance run
# Knowledge base
KNOWLEDGE_ORG_MAX_BYTES=             # default 52428800 (50 MB per organization)
KNOWLEDGE_PROMPT_MAX_CHARS=          # default 8000: total of 'Always include' documents
KNOWLEDGE_PROMPT_DOC_MAX_BYTES=      # default 32768
ELEVENLABS_CRAWL_MAX_PAGES=          # default 25 (max 50) pages per website import
ELEVENLABS_CRAWL_PATTERN_SYNTAX=     # default regex | glob | off
ELEVENLABS_KB_SYNC_DAYS=             # default 7: auto-sync frequency of URL documents and crawls
ELEVENLABS_RAG_MAX_DOCS_LENGTH=      # default 12000
ELEVENLABS_RAG_MAX_CHUNKS=           # default 6
ELEVENLABS_RAG_MAX_VECTOR_DISTANCE=  # default 0.6
ELEVENLABS_RAG_NUM_CANDIDATES=       # optional (provider default)
# Voices
ELEVENLABS_DEFAULT_VOICE_MIGRATION_AT= # default 2026-12-15T00:00:00Z: auto-switch agents off retiring default voices
ELEVENLABS_MAX_CLONES_PER_ORG=       # default 2 (cloned + designed voices)
ELEVENLABS_VOICE_DESIGN_MODEL=       # default eleven_multilingual_ttv_v2 | eleven_ttv_v3
ELEVENLABS_TTS_ZERO_RETENTION=       # default on (previews sent with enable_logging=false)
ELEVENLABS_TTS_HISTORY_RETENTION_DAYS= # optional 1-365: purge old TTS history items
ELEVENLABS_VOICE_ORPHAN_DELETE=      # default false: maintenance only reports orphan clones
ELEVENLABS_LIBRARY_REMOVAL_AUTO_SWITCH= # default on: switch agents off library voices being removed
ELEVENLABS_VOICE_NOTICE_WEBHOOK_SECRET= # HMAC secret of the voice_library_removal_notice webhook (optional)
# Messages and texts from calls
MESSAGE_EMAIL_DAILY_CAP=             # default 100 message-alert e-mails per org per day
SMS_DAILY_CAP_PER_ORG=               # default 50 workflow texts per org per day

# ── Cartesia (fallback) ──────────────────────────────────────────────────────
CARTESIA_API_KEY=
CARTESIA_API_VERSION=                # default 2026-08-14 (required by /agents endpoints)
CARTESIA_API_BASE_URL=               # optional, default https://api.cartesia.ai
CARTESIA_SIP_USERNAME=               # credentials of the platform SIP trunk provider (Twilio → Cartesia)
CARTESIA_SIP_PASSWORD=
CARTESIA_SIP_DOMAIN=                 # default sip.cartesia.ai
CARTESIA_SIP_TRANSPORT=              # tls (default) | tcp
CARTESIA_SIP_EDGE=                   # optional Twilio edge, e.g. frankfurt
CARTESIA_WEBHOOK_SECRET=             # ≥24 chars: x-webhook-secret of the call-event webhook
CARTESIA_TOOL_SECRET=                # ≥24 chars: bearer token of the get_call_context tool
CARTESIA_AGENT_LLM=                  # optional, default gpt-5.4-mini
CARTESIA_FALLBACK_VOICES=            # optional JSON {"ro":"<voice-id>","en":"<voice-id>"}
CARTESIA_SIP_PROVIDER_ID=            # optional: pin existing platform resources instead of auto-creating
CARTESIA_WEBHOOK_ID=
CARTESIA_CONTEXT_TOOL_ID=

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                   # also validates X-Twilio-Signature on every webhook

# ── Platform admin / jobs ────────────────────────────────────────────────────
CRON_SECRET=                         # ≥16 chars; Vercel Cron sends it as a bearer token
ADMIN_API_TOKEN=                     # ≥32 chars; diagnostics/reconcile/circuit/smoke-test endpoints
PLATFORM_ADMIN_USER_IDS=             # comma-separated Supabase user ids allowed on admin endpoints
APP_BASE_URL=                        # scripts only: default for --base-url

# ── Billing / email / invoicing / integrations (unchanged) ───────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids per plan (required when STRIPE_SECRET_KEY is set; a paid plan
# without a price falls back to the trial instead of being granted).
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMARTBILL_USERNAME=
SMARTBILL_TOKEN=
SMARTBILL_COMPANY_VAT_CODE=
SMARTBILL_SERIES=
SMARTBILL_LANGUAGE=
SMARTBILL_TAX_NAME=
SMARTBILL_TAX_PERCENTAGE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
