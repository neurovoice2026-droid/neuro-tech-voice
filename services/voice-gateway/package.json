{
  "name": "@neuro-tech-voice/voice-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Long-lived WebSocket voice gateway: Twilio/browser audio <-> Cartesia (self-orchestrated or Managed Agents) with ElevenLabs fallback.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^7.17.0",
    "undici": "^7.29.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
