{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 7 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/remotion-trailer": false,
      "claude/trailer-voices-*": false
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)trailer'"
}
