{
  "name": "neuro-tech-voice-trailer",
  "version": "1.0.0",
  "private": true,
  "description": "Neuro Tech Voice — 30s motion design trailer (Remotion)",
  "type": "module",
  "scripts": {
    "sfx": "node --experimental-strip-types --no-warnings scripts/generate-sfx.mjs",
    "studio": "remotion studio",
    "render:landscape": "remotion render Trailer-16x9 out/neurotechvoice-trailer-16x9.mp4",
    "render:vertical": "remotion render Trailer-9x16 out/neurotechvoice-trailer-9x16.mp4",
    "render": "npm run render:landscape && npm run render:vertical && npm run render:mix && npm run check:render",
    "render:mix": "node -e \"require('node:fs').copyFileSync('public/sfx/mix.wav','out/final-mix.wav')\"",
    "check:render": "node --experimental-strip-types --no-warnings scripts/check-render.mjs out/neurotechvoice-trailer-16x9.mp4 out/neurotechvoice-trailer-9x16.mp4",
    "typecheck": "tsc --noEmit",
    "sfx:force": "node --experimental-strip-types --no-warnings scripts/generate-sfx.mjs --force",
    "check:audio": "node --experimental-strip-types --no-warnings scripts/check-mix.mjs",
    "voice": "node scripts/generate-voice.mjs",
    "voice:remaster": "node scripts/generate-voice.mjs --remaster"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@remotion/cli": "^4.0.530",
    "@remotion/motion-blur": "^4.0.530",
    "@remotion/noise": "^4.0.530",
    "lucide-react": "^1.49.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.530"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "sherpa-onnx-node": "^1.13.8",
    "typescript": "^7.0.2"
  }
}
